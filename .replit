# Static portfolio only; no API or development server is published.
modules = ["nodejs-24"]

[deployment]
deploymentTarget = "static"
build = ["pnpm", "build"]
publicDir = "dist"

[[deployment.responseHeaders]]
path = "/*"
name = "Content-Security-Policy"
value = "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; media-src 'none'; worker-src 'none'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'self'"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/*"
name = "Referrer-Policy"
value = "strict-origin-when-cross-origin"

[[deployment.responseHeaders]]
path = "/*"
name = "Permissions-Policy"
value = "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Frame-Options"
value = "SAMEORIGIN"

[[deployment.responseHeaders]]
path = "/*"
name = "Strict-Transport-Security"
value = "max-age=31536000"

[[deployment.rewrites]]
from = "/work"
to = "/work/index.html"

[[deployment.rewrites]]
from = "/work/"
to = "/work/index.html"

[[deployment.rewrites]]
from = "/work/medfind"
to = "/work/medfind/index.html"

[[deployment.rewrites]]
from = "/work/medfind/"
to = "/work/medfind/index.html"

[[deployment.rewrites]]
from = "/work/tripsync-ai"
to = "/work/tripsync-ai/index.html"

