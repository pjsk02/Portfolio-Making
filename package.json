{
  "name": "je-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:publishing": "node --experimental-strip-types --test build/publishing.test.ts",
    "verify:published": "node --experimental-strip-types build/verify-published.ts",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "test:unit": "node --test tests/bootstrap.test.mjs",
    "test:browser": "playwright test",
    "check": "pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "wouter": "^3.3.5"
  }
}
