{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; media-src 'none'; worker-src 'none'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/medfind",
      "destination": "/work/medfind/index.html"
    },
    {
      "source": "/work/medfind/",
      "destination": "/work/medfind/index.html"
    },
    {
      "source": "/work/tripsync-ai",
      "destination": "/work/tripsync-ai/index.html"
    },
    {
      "source": "/work/tripsync-ai/",
      "destination": "/work/tripsync-ai/index.html"
    },
    {
      "source": "/work/endoseg",
      "destination": "/work/endoseg/index.html"
    },
    {
      "source": "/work/endoseg/",
      "destination": "/work/endoseg/index.html"
    },
    {
      "source": "/work/momcart",
      "destination": "/work/momcart/index.html"
    },
    {
      "source": "/work/momcart/",
      "destination": "/work/momcart/index.html"
    },
    {
      "source": "/work/solarsketch",
      "destination": "/work/solarsketch/index.html"
    },
    {
      "source": "/work/solarsketch/",
      "destination": "/work/solarsketch/index.html"
    },
    {
      "source": "/work/langup",
      "destination": "/work/langup/index.html"
    },
    {
      "source": "/work/langup/",
      "destination": "/work/langup/index.html"
    },
    {
      "source": "/work/energy-cto",
      "destination": "/work/energy-cto/index.html"
    },
    {
      "source": "/work/energy-cto/",
      "destination": "/work/energy-cto/index.html"
    },
    {
      "source": "/work/sec-pipeline",
      "destination": "/work/sec-pipeline/index.html"
    },
    {
      "source": "/work/sec-pipeline/",
      "destination": "/work/sec-pipeline/index.html"
    },
    {
      "source": "/work/food-inspections",
      "destination": "/work/food-inspections/index.html"
    },
    {
      "source": "/work/food-inspections/",
      "destination": "/work/food-inspections/index.html"
    },
    {
      "source": "/work/imdb-bi",
      "destination": "/work/imdb-bi/index.html"
    },
    {
      "source": "/work/imdb-bi/",
      "destination": "/work/imdb-bi/index.html"
    },
    {
      "source": "/work/nypd-analysis",
      "destination": "/work/nypd-analysis/index.html"
    },
    {
      "source": "/work/nypd-analysis/",
      "destination": "/work/nypd-analysis/index.html"
    },
    {
      "source": "/work/airline-system",
      "destination": "/work/airline-system/index.html"
    },
    {
      "source": "/work/airline-system/",
      "destination": "/work/airline-system/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
